+/* Publish the physical cell pitch separately from the toolkit's logical grid.
+ * The client keeps one read-only fd; zoom and monitor changes update it in place. */
+static void
+herdr_metrics_update (PtyxisTerminal *self)
+{
+  GtkNative *native = gtk_widget_get_native (GTK_WIDGET (self));
+  GdkSurface *surface = native ? gtk_native_get_surface (native) : NULL;
+  double scale = surface ? gdk_surface_get_scale (surface) : 1;
+  guint16 pitch[2];
+
+  if (!self->metrics_path || self->metrics_fd < 0)
+    return;
+  pitch[0] = GUINT16_TO_LE ((guint16) CLAMP (vte_terminal_get_char_width (VTE_TERMINAL (self)) * scale + 0.5, 1, 256));
+  pitch[1] = GUINT16_TO_LE ((guint16) CLAMP (vte_terminal_get_char_height (VTE_TERMINAL (self)) * scale + 0.5, 1, 512));
+  if (memcmp (pitch, self->metrics_pitch, sizeof pitch) != 0 &&
+      pwrite (self->metrics_fd, pitch, sizeof pitch, 0) == sizeof pitch)
+    memcpy (self->metrics_pitch, pitch, sizeof pitch);
+}
+
+static void
+herdr_metrics_realize (PtyxisTerminal *self)
+{
+  GtkNative *native = gtk_widget_get_native (GTK_WIDGET (self));
+  GdkSurface *surface = native ? gtk_native_get_surface (native) : NULL;
+
+  if (surface)
+    {
+      g_signal_handlers_disconnect_by_func (surface, herdr_metrics_update, self);
+      g_signal_connect_object (surface, "notify::scale", G_CALLBACK (herdr_metrics_update), self, G_CONNECT_SWAPPED);
+    }
+  herdr_metrics_update (self);
+}
+
+static void
+herdr_metrics_attach (PtyxisTerminal *self)
+{
+  VtePty *pty = vte_terminal_get_pty (VTE_TERMINAL (self));
+
+  if (!pty)
+    return;
+  if (!self->metrics_path)
+    {
+      self->metrics_path = g_build_filename (g_get_user_runtime_dir (), "herdr-cell-XXXXXX", NULL);
+      self->metrics_fd = g_mkstemp_full (self->metrics_path, O_RDWR | O_CLOEXEC, 0600);
+      if (self->metrics_fd < 0)
+        {
+          g_clear_pointer (&self->metrics_path, g_free);
+          return;
+        }
+    }
+  herdr_metrics_update (self);
+  g_object_set_data_full (G_OBJECT (pty), "herdr-cell-file", g_path_get_basename (self->metrics_path), g_free);
+}
+
+/* Read only immutable, owner-private RGBA buffers produced by a local client. */
+static GdkTexture *
+herdr_preview_load (const char *name,
+                    guint32    *x,
+                    guint32    *y,
+                    guint32    *cw,
+                    guint32    *ch)
+{
+  g_autofree char *path = NULL;
+  g_autofree guchar *pixels = NULL;
+  g_autoptr(GBytes) bytes = NULL;
+  g_autofd int fd = -1;
+  struct stat st;
+  guint32 header[5], w, h;
+  guint32 pitch[2];
+  gsize header_size = sizeof header;
+  gsize length, offset = 0;
+
+  if (!name || strlen (name) != 30 || !g_str_has_prefix (name, "herdr-preview-") ||
+      strspn (name + 14, "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ") != 16)
+    return NULL;
+  path = g_build_filename (g_get_user_runtime_dir (), name, NULL);
+  fd = open (path, O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC);
+  if (fd < 0 || fstat (fd, &st) < 0 || !S_ISREG (st.st_mode) ||
+      st.st_uid != getuid () || (st.st_mode & 0077) ||
+      read (fd, header, sizeof header) != sizeof header)
+    return NULL;
+  *cw = *ch = 0;
+  if (memcmp (header, "HDP2", 4) == 0)
+    {
+      if (read (fd, pitch, sizeof pitch) != sizeof pitch)
+        return NULL;
+      *cw = GUINT32_FROM_LE (pitch[0]);
+      *ch = GUINT32_FROM_LE (pitch[1]);
+      if (!*cw || !*ch || *cw > 256 || *ch > 512)
+        return NULL;
+      header_size += sizeof pitch;
+    }
+  else if (memcmp (header, "HDP1", 4) != 0)
+    return NULL;
+  *x = GUINT32_FROM_LE (header[1]);
+  *y = GUINT32_FROM_LE (header[2]);
+  w = GUINT32_FROM_LE (header[3]);
+  h = GUINT32_FROM_LE (header[4]);
+  if (*x > (1U << 24) || *y > (1U << 24) || !w || !h || (guint64) w * h > 8 * 1024 * 1024)
+    return NULL;
+  length = (gsize) w * h * 4;
+  if (st.st_size != header_size + length)
+    return NULL;
+  pixels = g_malloc (length);
+  while (offset < length)
+    {
+      ssize_t n = read (fd, pixels + offset, length - offset);
+      if (n < 0 && errno == EINTR)
+        continue;
+      if (n <= 0)
+        return NULL;
+      offset += n;
+    }
+  bytes = g_bytes_new_take (g_steal_pointer (&pixels), length);
+  return gdk_memory_texture_new (w, h, GDK_MEMORY_R8G8B8A8, bytes, w * 4);
+}
+
+static gboolean
+herdr_preview_update (gpointer data)
+{
+  PtyxisTerminal *self = data;
+  const char *name = vte_terminal_get_termprop_string (VTE_TERMINAL (self), "vte.ext.herdr.preview", NULL);
+
+  self->preview_idle = 0;
+  g_clear_object (&self->preview);
+  self->preview = herdr_preview_load (name, &self->preview_x, &self->preview_y, &self->raster_cw, &self->raster_ch);
+  gtk_widget_queue_draw (GTK_WIDGET (self));
+  return G_SOURCE_REMOVE;
+}
+
+static void
+herdr_preview_changed (PtyxisTerminal *self,
+                       const char     *property,
+                       gpointer        unused)
+{
+  if (!self->preview_idle)
+    self->preview_idle = g_idle_add (herdr_preview_update, self);
+}
+
+static void
+herdr_preview_clear (PtyxisTerminal *self)
+{
+  vte_terminal_reset_termprop (VTE_TERMINAL (self), "vte.ext.herdr.preview");
+}
